# Claude Code: keep local session state out, but COMMIT project skills —
# cloud sessions only get skills that live in the repo.
.claude/*
!.claude/skills/
!.claude/settings.json

# Environment files — NEVER commit these
.env
.env.local
.env.production
.env.staging
*.env
.env.*

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/

# Node
node_modules/
dist/
.next/

# Secrets
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
service-account*.json
