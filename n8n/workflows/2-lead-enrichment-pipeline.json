            { "name": "X-N8N-Secret", "value": "={{ $env.N8N_SECRET }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"lead_id\": \"{{ $('Trigger: New Lead Created').item.json.lead_id }}\", \"channel\": \"email\"}",
        "options": {}
      },
      "id": "20000002-0000-0000-0000-000000000008",
      "name": "Trigger Outreach Sequence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1780, 180]
    },
    {
      "parameters": {},
      "id": "20000002-0000-0000-0000-000000000009",
      "name": "Low Score — Skip Outreach",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1780, 420]
    }
  ],
