            { "name": "X-N8N-Secret", "value": "={{ $env.N8N_SECRET }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"agent\": \"website_analyzer\", \"lead_id\": \"{{ $json.lead_id }}\", \"params\": {}}",
        "options": {}
      },
      "id": "20000002-0000-0000-0000-000000000002",
      "name": "Analyse Website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "resume": "timeInterval",
