# ══════════════════════════════════════════════
#  L&D Designs — Agency Platform
#  Copy this to .env and fill in your values
# ══════════════════════════════════════════════

# ── Supabase ──────────────────────────────────
# Get these from supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── OpenAI ────────────────────────────────────
# Get from platform.openai.com → API Keys
# Uses gpt-4o-mini — very cheap (~£0.15 per 1000 outreach messages)
OPENAI_API_KEY=sk-your-key-here

# ── Gmail SMTP ────────────────────────────────
# Use an App Password — NOT your real Gmail password
# myaccount.google.com → Security → App Passwords
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Twilio SMS (optional — email-first by default) ──
# Get from twilio.com/console
# Leave blank to disable SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Your Business ─────────────────────────────
FOUNDER_PHONE=07301181878
FOUNDER_EMAIL=your@gmail.com
BUSINESS_NAME=L&D Designs
BUSINESS_WEBSITE=https://dylantownley12.github.io/L-D-Designss

# ── App Settings ──────────────────────────────
# Set to "production" when live
APP_ENV=development
# Secret key for API auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret

# ── Outreach Settings ─────────────────────────
# Daily email send limit (stay under 500 to avoid Gmail spam flags)
MAX_EMAILS_PER_DAY=50
# Daily SMS limit
MAX_SMS_PER_DAY=20
# Require founder approval before sending? (true/false)
REQUIRE_APPROVAL=true

# ── Preview Storage ───────────────────────────
# Where preview HTML files are served from
# During dev: http://localhost:8000/previews/
# In prod: your Railway/Render backend URL
PREVIEW_BASE_URL=http://localhost:8000/previews

# ══════════════════════════════════════════════
#  TRADES LEAD-CAPTURE PRODUCT + JARVIS (Telegram operator)
# ══════════════════════════════════════════════

# ── Anthropic / model ─────────────────────────
# Powers JARVIS + the trades sales agents (Sales Prep, Follow-up drafts).
ANTHROPIC_API_KEY=your-anthropic-key-here
# Model id JARVIS + agents use. Swap to claude-fable-5 when you want it — no code change.
CLAUDE_MODEL=claude-opus-4-8

# ── JARVIS Telegram bot (founders only) ───────
# 1. Create a bot with @BotFather → get the token.
# 2. Message your bot, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to use JARVIS (founders only).
FOUNDER_CHAT_IDS=
# Optional: map each founder to a chat id so the 08:00 call lists go to the right person.
FOUNDER_D_CHAT_ID=
FOUNDER_L_CHAT_ID=

# ── Internal Ops Board gate (founders only) ───
# Required to open /ops and call /api/sales/* , /api/cron/* , /api/agents/scout.
# Falls back to SECRET_KEY if left blank — but set a strong value in production.
OPS_KEY=

# ── Public links ──────────────────────────────
# Where the capture form + client dashboard live (used to build links in messages).
FRONTEND_BASE_URL=https://l-d-designss.vercel.app
